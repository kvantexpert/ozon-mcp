[Unit]
Description=Ozon Performance MCP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/kvantexpert/marketplaces-mcp-ru
EnvironmentFile=/root/.config/ozon-mcp/perf.env
Environment=PATH=/opt/kvantexpert/marketplaces-mcp-ru/.venv/bin:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/kvantexpert/marketplaces-mcp-ru/.venv/bin/ozon-perf-mcp
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
